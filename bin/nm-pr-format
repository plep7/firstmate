#!/usr/bin/env python3
"""Reformat a no-mistakes-generated PR body into the team's template.

no-mistakes compiles its PR format into the binary (## What Changed / Risk
Assessment / Testing-as-essay-plus-evidence / Pipeline + a cubic footer) with
no config knob. This post-processes the open PR for a branch into:

    [API-XXXX](jira link)

    ## Summary       — WHY the change exists (motivation/problem); pass --summary
    ## What Changed  — WHAT changed (no-mistakes' What Changed bullets)
    ## How           — HOW it works + a mermaid diagram; pass --how (optional)
    ## Evidence      — visual evidence (screenshots/GIF/video, before/after);
                        pass --evidence (optional); type-agnostic, the caller
                        composes the exact markdown
    ## Testing       — bullet points (de-backticked) + the original <details> evidence

Risk Assessment, the Pipeline section, and the cubic footer are dropped; the
Testing evidence <details> from no-mistakes are preserved verbatim.

Usage:
  nm-pr-format [PR] --summary "why..." [--how "$(cat how.md)"] \
               [--evidence "$(cat evidence.md)"] \
               [--testing $'- a\\n- b'] [--repo o/n] [--apply] [--force]

Without --apply it prints the proposed body (dry run). Run it once the gate
reaches checks-passed; re-run before merging if no-mistakes rewrites the body
after a base-branch rebase. The body is only distilled if it still has the raw
'## Pipeline' section — no-mistakes always emits one, and a reformatted body
never has one (Pipeline is dropped, never re-added) — so its absence means the
body is already reformatted, or hand-written; use --force to redo. (An earlier
version of this guard checked for '## What Changed' instead, but this script's
own reformatted output keeps that header, so it never actually caught a
second invocation; '## Pipeline' is the field that is reliably present before
a reformat and reliably absent after one.)

Automation (non-interactive callers, e.g. a crewmate invoking this right after
checks-green, per the fleet's no-mistakes ship pipeline): --apply already runs
with no prompts, so no separate "non-interactive" flag is needed. Exit codes
let an automated caller tell "nothing to do" apart from "something broke"
without parsing stderr text:

    0  success — applied, or a dry run printed the proposed body
    1  a real error: gh failure, PR not found, bad repo, etc.
    2  argparse usage error (Python's own default for malformed CLI arguments)
    3  intentional skip: the PR body is already reformatted (or hand-written)
       — not an error; safe for a caller to treat as "already done"

Calling `--apply` twice for the same checks-green event is safe: the second
call hits exit code 3 and leaves the PR body untouched.
"""
import argparse
import html
import json
import os
import re
import subprocess
import sys
import tempfile

JIRA_BASE = "https://unlearnai.atlassian.net/browse/"

EXIT_ERROR = 1
EXIT_ALREADY_REFORMATTED = 3

# The section that marks a body as not-yet-reformatted. no-mistakes always
# emits '## Pipeline'; this script's own output never re-adds it, so its
# absence is a reliable already-reformatted signal (unlike '## What Changed',
# which this script's own output preserves — see the module docstring).
RAW_MARKER_SECTION = "Pipeline"


def fail(msg, code=EXIT_ERROR):
    sys.stderr.write(msg.rstrip("\n") + "\n")
    sys.exit(code)


def gh(args):
    r = subprocess.run(["gh", *args], capture_output=True, text=True)
    if r.returncode != 0:
        fail(f"gh error: {r.stderr.strip() or r.stdout.strip()}")
    return r.stdout


def split_sections(body):
    """Map '## Header' -> content. Lines before the first header are ignored."""
    sections, cur, buf = {}, None, []
    for line in body.splitlines():
        m = re.match(r"^##\s+(.*\S)\s*$", line)
        if m:
            if cur is not None:
                sections[cur] = "\n".join(buf).strip()
            cur, buf = m.group(1).strip(), []
        else:
            buf.append(line)
    if cur is not None:
        sections[cur] = "\n".join(buf).strip()
    return sections


def details_blocks(text):
    return re.findall(r"<details>.*?</details>", text, flags=re.S)


def clean_bullet(b):
    """Strip no-mistakes' <code>/backtick wrapping and unescape HTML entities,
    keeping any inner `code spans` intact."""
    b = b.strip()
    m = re.fullmatch(r"<code>(.*)</code>", b, flags=re.S)
    if m:
        b = m.group(1)
    b = html.unescape(b)
    if len(b) > 1 and b[0] == "`" and b[-1] == "`" and "`" not in b[1:-1]:
        b = b[1:-1]
    return b.strip()


def bullets_from(text):
    out = []
    for line in text.splitlines():
        s = line.strip()
        if s.startswith("- "):
            out.append(clean_bullet(s[2:]))
    return [b for b in out if b]


def test_step_bullets(pipeline_text):
    """Pull the Test step's bullet points out of the Pipeline section."""
    for block in details_blocks(pipeline_text):
        summ = re.search(r"<summary>(.*?)</summary>", block, flags=re.S)
        if summ and re.search(r"\*\*Test\*\*", summ.group(1)):
            return bullets_from(block)
    return []


def main():
    ap = argparse.ArgumentParser(description="Reformat a no-mistakes PR body.")
    ap.add_argument("pr", nargs="?", help="PR number (default: current branch's PR)")
    ap.add_argument("--summary", help="## Summary: WHY the change exists; defaults to the title")
    ap.add_argument("--how", help="## How: markdown body, may include a ```mermaid block")
    ap.add_argument(
        "--evidence",
        help="## Evidence: markdown body (screenshots, before/after pairs, "
        "embedded video/GIF links); passed through verbatim, no per-type logic",
    )
    ap.add_argument("--testing", help="newline-separated Testing bullets; overrides the pipeline's Test step")
    ap.add_argument("--repo", help="owner/name (default: current repo)")
    ap.add_argument("--apply", action="store_true", help="update the PR (else dry run)")
    ap.add_argument("--force", action="store_true", help="reformat even if the body looks already-reformatted")
    args = ap.parse_args()

    view = ["pr", "view"]
    if args.pr:
        view.append(args.pr)
    view += ["--json", "number,title,body"]
    if args.repo:
        view += ["--repo", args.repo]
    pr = json.loads(gh(view))

    title, body, num = pr["title"], pr.get("body") or "", pr["number"]
    sections = split_sections(body)

    if RAW_MARKER_SECTION not in sections and not args.force:
        fail(
            f"PR #{num}: no '## {RAW_MARKER_SECTION}' section — already reformatted or "
            f"hand-written; skipping (use --force to override).",
            EXIT_ALREADY_REFORMATTED,
        )

    changes = sections.get("What Changed", "").strip()
    orig_testing = sections.get("Testing", "")

    if args.testing:
        bullets = [clean_bullet(b.lstrip("-* ")) for b in args.testing.splitlines() if b.strip()]
    else:
        bullets = test_step_bullets(sections.get("Pipeline", ""))

    testing_parts = []
    if bullets:
        testing_parts.append("\n".join(f"- {b}" for b in bullets))
    testing_parts.extend(details_blocks(orig_testing))  # preserve no-mistakes' evidence
    testing = "\n\n".join(p for p in testing_parts if p).strip()

    m = re.search(r"\b(API-\d+)\b", title)
    ticket = m.group(1) if m else None
    summary = args.summary or re.sub(r"^\s*API-\d+[:\s]+", "", title).strip()

    parts = []
    if ticket:
        parts.append(f"[{ticket}]({JIRA_BASE}{ticket})")
    parts.append(f"## Summary\n\n{summary}")
    if changes:
        parts.append(f"## What Changed\n\n{changes}")
    if args.how:
        parts.append(f"## How\n\n{args.how.strip()}")
    if args.evidence:
        parts.append(f"## Evidence\n\n{args.evidence.strip()}")
    if testing:
        parts.append(f"## Testing\n\n{testing}")
    new_body = "\n\n".join(parts).strip() + "\n"

    if not args.apply:
        sys.stdout.write(new_body)
        sys.stderr.write(f"\n[dry-run] PR #{num}; re-run with --apply to update.\n")
        return

    with tempfile.NamedTemporaryFile("w", suffix=".md", delete=False) as f:
        f.write(new_body)
        path = f.name
    try:
        edit = ["pr", "edit", str(num), "--body-file", path]
        if args.repo:
            edit += ["--repo", args.repo]
        gh(edit)
    finally:
        os.unlink(path)
    print(f"Updated PR #{num} body.")


if __name__ == "__main__":
    main()
